@{
    ViewData["Title"] = "SurveyPages";
}


<div>

        <section class="question-page">
            <h3 class="question-page-title">Verbal IQ Tests</h3>

            <div class="question-timer">
                <p>2:10</p>
            </div>
            <div class="timebar">
                <div class="elapsed-time">
                </div>
            </div>

            <h4 class="question-counter">
                Question 1/20
            </h4>

            <p class="survey-question">
                Choose the word closest in meaning to “ABUNDANT.”
            </p>

            <div class="answer-options-wrapper">
                <div class="answer-option">
                    <h5>Rare</h5>
                </div>
                <div class="answer-option">
                    <h5>Plentiful</h5>
                </div>
                <div class="answer-option">
                    <h5>Scarce</h5>
                </div>
                <div class="answer-option">
                    <h5>Tiny</h5>
                </div>
            </div>
       </section>


</div>
