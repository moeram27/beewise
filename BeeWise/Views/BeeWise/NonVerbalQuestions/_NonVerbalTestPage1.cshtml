@{
    ViewData["Title"] = "NonVerbalTests";
}


<div>

    <section class="question-page">
        <h3 class="question-page-title">NON VERBAL IQ TESTS</h3>

        <div class="question-timer">
            <p>2:10</p>
        </div>
        <div class="timebar">
            <div class="elapsed-time">
            </div>
        </div>

        <h4 class="question-counter">
            Question 1/20
        </h4>

        <p class="survey-question">
            Identify the missing objects
        </p>

        <div class="non-verbal-question-wrapper">
            <div class="question-image">
                <img class="nonVerbal-question" src="@Url.Content("~/Assets/Images/NonVerbalIqTests/TestQuestions/non-verbal-iq-question-1.png")" alt="">
            </div>
            <div class="nonverbal-answers-wrapper">
                <div class="nonVerbal-answer-option">
                    <span>
                        A
                    </span>
                    <img class="nonVerbal-option" src="@Url.Content("~/Assets/Images/NonVerbalIqTests/AnswerOptions/non-verbal-option-1.png")" alt="">
                </div>
                <div class="nonVerbal-answer-option">
                    <span>
                        B
                    </span>
                    <img class="nonVerbal-option" src="@Url.Content("~/Assets/Images/NonVerbalIqTests/AnswerOptions/non-verbal-option-2.png")" alt="">
                </div>
                <div class="nonVerbal-answer-option">
                    <span>
                        C
                    </span>
                    <img class="nonVerbal-option" src="@Url.Content("~/Assets/Images/NonVerbalIqTests/AnswerOptions/non-verbal-option-3.png")" alt="">
                </div>
                <div class="nonVerbal-answer-option">
                    <span>
                        D
                    </span>
                    <img class="nonVerbal-option" src="@Url.Content("~/Assets/Images/NonVerbalIqTests/AnswerOptions/non-verbal-option-4.png")" alt="">

                </div>
            </div>
        </div>
    </section>


</div>
