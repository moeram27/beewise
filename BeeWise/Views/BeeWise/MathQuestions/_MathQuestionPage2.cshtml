@{
    ViewData["Title"] = "MathTests";
}


<div>

    <section class="question-page">
        <h3 class="question-page-title">LOGICAL/MATH IQ TESTS</h3>

        <div class="question-timer">
            <p>2:10</p>
        </div>
        <div class="timebar">
            <div class="elapsed-time">
            </div>
        </div>

        <h4 class="question-counter">
            Question 2/20
        </h4>

        <p class="survey-question">
            Arrange the fractions in ascending order
        </p>
        <div class="math-quesion-wrapper">
            <div class="question-image">
                <img class="math-test-question" src="@Url.Content("~/Assets/Images/MathTests/math-question-1.png")" alt="">
            </div>
            <div class="math-answer-options-wrapper">
                <div class="math-answer-option">
                    <h5>9/18,5/8,4/5,9/10,17/20</h5>
                </div>
                <div class="math-answer-option">
                    <h5>9/18,5/8,17/20,4/5,9/10</h5>
                </div>
                <div class="math-answer-option">
                    <h5>5/8,9/18,17/20,9/10,4/5</h5>
                </div>
                <div class="math-answer-option">
                    <h5>9/18,5/8,4/5,17/20,9/10</h5>
                </div>
            </div>
        </div>
    </section>


</div>
