@{
    ViewData["Title"] = "MathTests";
}


<div>

    <section class="question-page">
        <h3 class="question-page-title">LOGICAL/MATH IQ TESTS</h3>

        <div class="question-timer">
            <p>2:10</p>
        </div>
        <div class="timebar">
            <div class="elapsed-time">
            </div>
        </div>

        <h4 class="question-counter">
            Question 1/20
        </h4>

        <p class="survey-question">
            Can you solve this? <br />
            If 10 people can do a piece of work in 5 days, working 2 hours a day,<br />
            how long will 2 people take to do the same work, working 5 hours a day?
        </p>

        <div class="answer-options-wrapper">
            <div class="answer-option">
                <h5>8</h5>
            </div>
            <div class="answer-option">
                <h5>5</h5>
            </div>
            <div class="answer-option">
                <h5>10</h5>
            </div>
            <div class="answer-option">
                <h5>12</h5>
            </div>
        </div>
    </section>


</div>
