@{
    ViewData["Title"] = "Verbal IQ Results";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
    <link rel="stylesheet" href="~/css/TestsResuts.css" />
}

<div class="results-content-wrapper">

    <h4 class="iq-test-title-result">
        Logical/Math IQ Tests
    </h4>

    <h2 class="user-score">
        YOUR SCORE: <span class="user-math-test-score">
            110
        </span>
    </h2>

    <div class="user-positioning">

        <p class="user-iq-level">
            Number Master
        </p>
        <p class="user-iq-position">
            You Scored Higher Than 80% Of Test-Takers
        </p>
    </div>

    <div class="skills-hexagon">
        <h5 class="hexagon-title">
            Skills Breakdown
        </h5>
        <img class="hexagon-skills" src="@Url.Content("~/Assets/Images/TestResults/percentege-hexagon.png")" alt="Alternate Text" />
    </div>

    <div class="test-feedback">
        <ul class="feedback-list">
            <li>
                our logical deduction skills are outstanding!
                You have a strong ability to break down problems and find solutions quickly.
            </li>
            <li>
                Your pattern recognition is solid, but there’s room for improvement.
                Try practicing numerical sequences and logic-based puzzles.
            </li>
        </ul>
    </div>

    <p class="category-weekly-ranking">
        You ranked #8 in this week’s Math IQ Challenge!
    </p>

    <div class="button-container">
        <a asp-controller="BeeWise" asp-action="MathTests" class="math-redirect">

            <button id="retake-test">
                Retake the test
            </button>
        </a>

        <p class="retake-test-condition">
            If the score is low
        </p>

        <a asp-controller="BeeWise" asp-action="SubCategories" class="categories-redirect">
            <button id="next-level-test">
                Challenge Yourself With New Test
            </button>
        </a>
    </div>

    <a asp-controller="BeeWise" asp-action="" class="home-redirect">
        <button id="home-btn">
            Go Home
        </button>
    </a>
</div>
