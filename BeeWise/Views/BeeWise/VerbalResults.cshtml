@{
    ViewData["Title"] = "Verbal IQ Results";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}


<h4 class="iq-test-title">
    VERBAL IQ TESTS
</h4>

<h2 class="user-score">
    YOUR SCORE: 130
</h2>

<div class="user-positioning">

    <p class="user-iq-level">
        Genius Level
    </p>
    <p class="user-iq-position">
        You Scored Higher Than 85% Of Test-Takers
    </p>
</div>

<div class="badge-earn"> 

    <h5 class="badge-announcement">
        You Have Earned A New Badge!
    </h5>
    <h5 class="badge-name">
        Pattern Prodigy
    </h5>
</div>

<div class="skills-hexagon">
    <h5 class="hexagon-title">
        Skills Breakdown
    </h5>
    <img class="hexagon-skills" src="@Url.Content("~/Assets/Images/sidebar-icons/sidebar-idcon-beehive.png")" alt="Alternate Text" />
</div>

@*add ul element*@