@{
    ViewData["Title"] = "OP Login";
}

@{
    Layout = "~/Views/Account/_LoginLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login/op-login.css" />
}
<div class="container-wrapper">
    <div class="login-info">
        <h3 class="login-title">
            Log in & Test Your Brilliance
        </h3>
        <h3 class="signin-option">
            Sign in through operator
        </h3>
        <p class="signin-instructions">
            Please insert your number
        </p>
        <div class="login-form">
            <form action="/BeeWise/Index" method="post">
                <div class="code-input-wrapper">
                    <label for="code">Code:</label>
                    <div class="input-group">
                        <input type="tel" id="code" name="code" required maxlength="3">
                    </div>
                </div>
                <div class="msisdn-input-wrapper">
                    <label for="msisdn">Mobile Number</label>
                    <input type="number" id="msisdn" name="msisdn" required>
                </div>
                <button class="login-btn" type="submit">Continue</button>
            </form>

        </div>
    </div>
</div>
