<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BeeWise Login</title>
    <link rel="stylesheet" href="~/css/login/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lang-menu.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    @RenderSection("Styles", required: false)

</head>
<header class="login-header">
    <div class="gs-lang-menu">
        <div class="lang-dropdown-wrapper ">
            <button class="gs-selected-lang" onclick="openLangMenu(this)"><span>EN</span></button>
        </div>
        <ul class="gs-langs-wrapper">
            <li class="gs-lang">
                <a href="">AR</a>
            </li>
        </ul>
    </div>
    </div>
    <div class="login-logo">
        <a asp-controller="Account" asp-action="" class="home-redirect">
            <img class="logo" src="@Url.Content("~/Assets/Images/logos/logo.png")">
        </a>
    </div>
</header>
<body>
    <div class="content-wrapper">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>window.jQuery || document.write('<script src="~/lib/jquery/dist/jquery.min.js"><\/script>');</script>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)



</body>
</html>
